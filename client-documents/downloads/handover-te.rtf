\pard\uc0\sa140\fs20 Narendra Koya\par
\pard\uc0\keepn\sb80\sa220\b\fs36 \u3125 \u3142 \u3116 \u3149 \u8204 \u3128 \u3144 \u3103 \u3149  \u3077 \u3114 \u3149 \u3114 \u3095 \u3135 \u3074 \u3108  \u3118 \u3120 \u3135 \u3119 \u3137  \u3128 \u3129 \u3134 \u3119 \u3074 \b0\par
\pard\uc0\sa100\fs23 \u3125 \u3142 \u3116 \u3149 \u8204 \u3128 \u3144 \u3103 \u3149  \u3077 \u3074 \u3110 \u3137 \u3093 \u3137 \u3112 \u3149 \u3112  \u3108 \u3120 \u3149 \u3125 \u3134 \u3108  \u3110 \u3134 \u3112 \u3135 \u3112 \u3135  \u3108 \u3142 \u3120 \u3125 \u3105 \u3134 \u3112 \u3135 \u3093 \u3135 , \u3094 \u3134 \u3108 \u3134 \u3122 \u3112 \u3137  \u3081 \u3114 \u3119 \u3147 \u3095 \u3135 \u3074 \u3098 \u3105 \u3134 \u3112 \u3135 \u3093 \u3135 , \u3128 \u3129 \u3134 \u3119 \u3074  \u3114 \u3146 \u3074 \u3110 \u3105 \u3134 \u3112 \u3135 \u3093 \u3135  \u3080  \u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3112 \u3137  \u3117 \u3110 \u3149 \u3120 \u3114 \u3120 \u3098 \u3137 \u3093 \u3147 \u3074 \u3105 \u3135 .\par
\pard\uc0\keepn\sb180\sa60\b\fs25 \u3077 \u3114 \u3149 \u3114 \u3095 \u3135 \u3074 \u3098 \u3135 \u3112 \u3125 \u3135 \b0\par
\pard\uc0\sa100\fs23 \u3093 \u3128 \u3149 \u3103 \u3118 \u3120 \u3149 , \u3114 \u3149 \u3120 \u3134 \u3100 \u3142 \u3093 \u3149 \u3103 \u3149 , \u3077 \u3114 \u3149 \u3114 \u3095 \u3135 \u3074 \u3108  \u3108 \u3143 \u3110 \u3136 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ]. \u3122 \u3144 \u3125 \u3149  \u3098 \u3135 \u3120 \u3137 \u3112 \u3134 \u3118 \u3134 , \u3128 \u3074 \u3098 \u3135 \u3093 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ].\par
\pard\uc0\sa100\fs23 \u3128 \u3147 \u3120 \u3149 \u3128 \u3149  \u3115 \u3144 \u3123 \u3149 \u3122 \u3137  \u3122 \u3143 \u3110 \u3134  \u3120 \u3135 \u3114 \u3147 \u3100 \u3135 \u3103 \u3120 \u3136  \u3078 \u3129 \u3149 \u3125 \u3134 \u3112 \u3074 : [\u3125 \u3149 \u3119 \u3093 \u3149 \u3108 \u3135 \u3095 \u3108  \u3122 \u3135 \u3074 \u3093 \u3149 ]. \u3093 \u3128 \u3149 \u3103 \u3118 \u3120 \u3149  \u3108 \u3142 \u3120 \u3135 \u3098 \u3135  \u3098 \u3138 \u3128 \u3135 \u3112  \u3108 \u3143 \u3110 \u3136 : [\u3108 \u3143 \u3110 \u3136 ].\par
\pard\uc0\sa100\fs23 \u3105 \u3146 \u3118 \u3144 \u3112 \u3149  \u3128 \u3074 \u3128 \u3149 \u3109 , \u3094 \u3134 \u3108 \u3134  \u3119 \u3100 \u3118 \u3134 \u3112 \u3135 , \u3120 \u3142 \u3112 \u3149 \u3119 \u3138 \u3125 \u3122 \u3149  \u3108 \u3143 \u3110 \u3136 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ]. \u3129 \u3147 \u3128 \u3149 \u3103 \u3135 \u3074 \u3095 \u3149  \u3128 \u3074 \u3128 \u3149 \u3109 , \u3119 \u3100 \u3118 \u3134 \u3112 \u3135 , \u3120 \u3142 \u3112 \u3149 \u3119 \u3138 \u3125 \u3122 \u3149  \u3108 \u3143 \u3110 \u3136 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ].\par
\pard\uc0\keepn\sb180\sa60\b\fs25 \u3128 \u3129 \u3134 \u3119 \u3074  \u3118 \u3120 \u3135 \u3119 \u3137  \u3128 \u3149 \u3125 \u3136 \u3093 \u3120 \u3107 \b0\par
\pard\uc0\sa100\fs23 \u3122 \u3147 \u3114 \u3134 \u3112 \u3149 \u3112 \u3135  \u3108 \u3142 \u3122 \u3135 \u3119 \u3100 \u3143 \u3128 \u3143  \u3118 \u3134 \u3120 \u3149 \u3095 \u3074 : [\u3115 \u3147 \u3112 \u3149  \u3122 \u3143 \u3110 \u3134  \u3080 \u3118 \u3142 \u3119 \u3135 \u3122 \u3149 ]. \u3077 \u3074 \u3095 \u3136 \u3093 \u3120 \u3135 \u3074 \u3098 \u3135 \u3112  \u3128 \u3129 \u3134 \u3119  \u3093 \u3134 \u3122 \u3074 , \u3077 \u3074 \u3110 \u3137 \u3122 \u3147  \u3098 \u3143 \u3128 \u3143  \u3128 \u3125 \u3120 \u3107 \u3122 \u3137 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ].\par
\pard\uc0\sa100\fs23 \u3093 \u3146 \u3108 \u3149 \u3108  \u3114 \u3143 \u3100 \u3136 \u3122 \u3137 , \u3125 \u3098 \u3112  \u3118 \u3134 \u3120 \u3149 \u3114 \u3137 \u3122 \u3137 , \u3108 \u3120 \u3149 \u3125 \u3134 \u3108 \u3135  \u3112 \u3135 \u3120 \u3149 \u3125 \u3129 \u3107 : [\u3125 \u3143 \u3120 \u3143  \u3077 \u3074 \u3098 \u3112 \u3134  \u3122 \u3143 \u3110 \u3134  \u3090 \u3114 \u3149 \u3114 \u3074 \u3110 \u3074 ].\par
\pard\uc0\sa100\fs23 \u3098 \u3135 \u3125 \u3120 \u3135  \u3098 \u3142 \u3122 \u3149 \u3122 \u3135 \u3074 \u3114 \u3137  \u3122 \u3143 \u3110 \u3134  \u3120 \u3128 \u3136 \u3110 \u3137  \u3128 \u3074 \u3094 \u3149 \u3119 , \u3128 \u3149 \u3109 \u3135 \u3108 \u3135 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ]. \u3118 \u3123 \u3149 \u3122 \u3136  \u3128 \u3074 \u3114 \u3149 \u3120 \u3110 \u3135 \u3074 \u3098 \u3134 \u3122 \u3149 \u3128 \u3135 \u3112  \u3108 \u3143 \u3110 \u3136 : [\u3108 \u3143 \u3110 \u3136  / \u3077 \u3125 \u3128 \u3120 \u3074  \u3122 \u3143 \u3110 \u3137 ].\par
\pard\uc0\sa100\fs23 \u3093 \u3128 \u3149 \u3103 \u3118 \u3120 \u3149  \u3111 \u3139 \u3125 \u3136 \u3093 \u3120 \u3107 : \u8220 \u3122 \u3144 \u3125 \u3149  \u3128 \u3144 \u3103 \u3149 , \u3077 \u3074 \u3095 \u3136 \u3093 \u3120 \u3135 \u3074 \u3098 \u3135 \u3112  \u3094 \u3134 \u3108 \u3134 \u3122 \u3137 , \u3115 \u3144 \u3123 \u3149 \u3122 \u3137  \u3112 \u3143 \u3112 \u3137  \u3108 \u3142 \u3120 \u3135 \u3098 \u3135  \u3098 \u3138 \u3126 \u3134 \u3112 \u3137 .\u8221  \u3114 \u3143 \u3120 \u3137 , \u3108 \u3143 \u3110 \u3136 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ].\par
