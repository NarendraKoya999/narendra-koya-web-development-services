\pard\uc0\sa100\fs23 [\u3093 \u3128 \u3149 \u3103 \u3118 \u3120 \u3149  \u3114 \u3143 \u3120 \u3137 , \u3125 \u3149 \u3119 \u3134 \u3114 \u3134 \u3120 \u3074 ] \u3093 \u3147 \u3128 \u3074  \u3112 \u3120 \u3143 \u3074 \u3110 \u3149 \u3120  \u3093 \u3147 \u3119  \u3108 \u3119 \u3134 \u3120 \u3137  \u3098 \u3143 \u3128 \u3135 \u3112  \u3111 \u3120  \u3077 \u3074 \u3098 \u3112 \u3134 . \u3077 \u3074 \u3098 \u3112 \u3134  \u3128 \u3074 \u3094 \u3149 \u3119 : [\u3128 \u3074 \u3094 \u3149 \u3119 ]. \u3108 \u3143 \u3110 \u3136 : [\u3108 \u3143 \u3110 \u3136 ]. \u3080  \u3077 \u3074 \u3098 \u3112 \u3134  \u3125 \u3120 \u3149 \u3108 \u3135 \u3074 \u3098 \u3143  \u3098 \u3135 \u3125 \u3120 \u3135  \u3108 \u3143 \u3110 \u3136 : [\u3108 \u3143 \u3110 \u3136 ].\par
