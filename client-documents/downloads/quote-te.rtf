\pard\uc0\sa100\fs23 \u3086 \u3074 \u3098 \u3137 \u3093 \u3137 \u3112 \u3149 \u3112  \u3114 \u3149 \u3119 \u3134 \u3093 \u3143 \u3100 \u3136 : [\u3114 \u3143 \u3120 \u3137 ]. \u3125 \u3142 \u3116 \u3149 \u8204 \u3128 \u3144 \u3103 \u3149  \u3122 \u3093 \u3149 \u3127 \u3149 \u3119 \u3074 : [\u3122 \u3093 \u3149 \u3127 \u3149 \u3119 \u3074 ].\par
\pard\uc0\sa100\fs23 \u3114 \u3149 \u3120 \u3098 \u3137 \u3120 \u3135 \u3074 \u3098 \u3135 \u3112  One-page Starter \u3086 \u3074 \u3098 \u3137 \u3093 \u3137 \u3074 \u3103 \u3143 : \u8377 4,999 \u3090 \u3093 \u3143 \u3128 \u3134 \u3120 \u3135 . \u3118 \u3146 \u3116 \u3144 \u3122 \u3149 \u8204 \u3093 \u3137  \u3128 \u3120 \u3135 \u3114 \u3147 \u3119 \u3143  \u3090 \u3093  \u3114 \u3143 \u3100 \u3136 , \u3095 \u3120 \u3135 \u3127 \u3149 \u3104 \u3074 \u3095 \u3134  \u3088 \u3110 \u3137  \u3125 \u3135 \u3117 \u3134 \u3095 \u3134 \u3122 \u3137 , \u3093 \u3134 \u3122 \u3149  \u3122 \u3143 \u3110 \u3134  \u3080 \u3118 \u3142 \u3119 \u3135 \u3122 \u3149  \u3122 \u3135 \u3074 \u3093 \u3149 , \u3090 \u3093  \u3125 \u3135 \u3105 \u3108  \u3128 \u3125 \u3120 \u3107 \u3122 \u3137 .\par
