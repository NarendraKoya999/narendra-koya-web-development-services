\pard\uc0\keepn\sb180\sa60\b\fs25 \u3111 \u3120  \u3118 \u3120 \u3135 \u3119 \u3137  \u3095 \u3105 \u3137 \u3125 \u3137 \b0\par
\pard\uc0\sa100\fs23 \u3114 \u3112 \u3135  \u3120 \u3137 \u3128 \u3137 \u3118 \u3137 : \u8377 [\u3118 \u3146 \u3108 \u3149 \u3108 \u3074 ]. \u3077 \u3110 \u3112 \u3074 \u3095 \u3134  \u3077 \u3074 \u3095 \u3136 \u3093 \u3120 \u3135 \u3074 \u3098 \u3135 \u3112  \u3114 \u3112 \u3137 \u3122 \u3137 : [\u3114 \u3112 \u3135 , \u3111 \u3120 ].\par
\pard\uc0\sa100\fs23 \u3105 \u3146 \u3118 \u3144 \u3112 \u3149 , \u3129 \u3147 \u3128 \u3149 \u3103 \u3135 \u3074 \u3095 \u3149  \u3094 \u3120 \u3149 \u3098 \u3137 \u3122 \u3137  \u3125 \u3143 \u3120 \u3137 . \u3112 \u3135 \u3120 \u3149 \u3125 \u3129 \u3107 , \u3079 \u3108 \u3120  \u3128 \u3143 \u3125 \u3122 \u3137 : [\u3125 \u3120 \u3149 \u3108 \u3135 \u3128 \u3149 \u3108 \u3143  \u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ].\par
\pard\uc0\sa100\fs23 \u3125 \u3120 \u3149 \u3108 \u3135 \u3074 \u3098 \u3143  \u3114 \u3112 \u3149 \u3112 \u3137 \u3122 \u3137  \u3122 \u3143 \u3110 \u3134  \u3079 \u3108 \u3120  \u3120 \u3137 \u3128 \u3137 \u3118 \u3137 \u3122 \u3137 : [\u3125 \u3135 \u3125 \u3120 \u3134 \u3122 \u3137 ]. \u3118 \u3146 \u3108 \u3149 \u3108 \u3074  \u3098 \u3142 \u3122 \u3149 \u3122 \u3135 \u3074 \u3098 \u3125 \u3122 \u3128 \u3135 \u3112 \u3110 \u3135 : \u8377 [\u3118 \u3146 \u3108 \u3149 \u3108 \u3074 ].\par
\pard\uc0\sa100\fs23 \u3098 \u3142 \u3122 \u3149 \u3122 \u3135 \u3074 \u3114 \u3137  \u3110 \u3126 \u3122 \u3137 , \u3108 \u3143 \u3110 \u3136 \u3122 \u3137 : [\u3077 \u3074 \u3095 \u3136 \u3093 \u3120 \u3135 \u3074 \u3098 \u3135 \u3112  \u3127 \u3120 \u3108 \u3137 \u3122 \u3137 ]. \u3108 \u3137 \u3110 \u3135  \u3128 \u3118 \u3134 \u3098 \u3134 \u3120 \u3074  \u3077 \u3074 \u3110 \u3135 \u3112  \u3108 \u3120 \u3149 \u3125 \u3134 \u3108  \u3098 \u3138 \u3114 \u3135 \u3074 \u3098 \u3143  \u3108 \u3143 \u3110 \u3136 : [\u3108 \u3143 \u3110 \u3136 ].\par
